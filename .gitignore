# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite runtime files
/data/*.db
/data/*.db-*
/data/*.db.*
/data/*.sqlite
/data/*.sqlite-*
/data/qa-artifacts/

# browser-test artifacts (curated screenshots live in /docs/screenshots)
/playwright-report/
/test-results/
/artifacts/

# generated by Prisma during npm install
/src/generated/prisma/

# high-resolution image-generation working copies; optimized WebP files are committed
/public/images/*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
